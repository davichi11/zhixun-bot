# ============================================================
# 智讯助手 · 环境变量样例
# 复制为 .env 后填写真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，千万不要提交
# ============================================================

# ------------------------------------------------------------ 运行环境
APP_NAME=智讯助手
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------ LLM（至少填一个）
# 用哪家就填哪家，并在 LLM_PROVIDER 里指定
# 模型 id 以 Agno 3.x 的默认为基准，升级框架时只改这里
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5.4
OPENAI_LIGHT_MODEL=gpt-5.4-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_LIGHT_MODEL=deepseek-v4-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

LLM_TEMPERATURE=0.3

# ------------------------------------------------------------ 数据库
# 开发态用 SQLite（默认即可），生产态切 Postgres：
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/zhixun
DATABASE_URL=

# ------------------------------------------------------------ 向量库
# lancedb 是**可选依赖**；不装则自动降级为内存实现（几百篇规模完全够用）
VECTOR_BACKEND=memory
VECTOR_DB_URI=
VECTOR_TABLE_ARTICLES=historical_articles

# ------------------------------------------------------------ 知识层（第 4 篇）
# 去重：URL 规范化精确匹配 + 标题语义相似度阈值
DEDUP_SIMILARITY_THRESHOLD=0.85
# 参与标题比对的历史项目条数上限（越多越准，也越贵）
DEDUP_MAX_CANDIDATES=500

# Embedding：openai = 有语义；hash = 零依赖确定性降级（无语义，仅去重兜底）
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_HASH_DIM=512

# 检索
RAG_TOP_K=5
# 历史文章目录（相对 backend 根目录）
HISTORY_ARTICLES_DIR=data/history
# 渐进式披露：默认注入多少条风格范文
CONTEXT_STYLE_SAMPLES=3

# ------------------------------------------------------------ 采集
# GitHub Token 可选，但填了能显著提高 API 限额（5000/h vs 60/h）
GITHUB_TOKEN=
COLLECTOR_MAX_ITEMS=30

# ------------------------------------------------------------ 工具层（第 3 篇）
# 单次工具调用的超时与重试。退避曲线：第 n 次等待 BASE_DELAY * 2^(n-1) + 随机抖动
TOOL_TIMEOUT_SECONDS=15
TOOL_MAX_ATTEMPTS=3
TOOL_RETRY_BASE_DELAY=0.5
# 单次 Agent 运行允许的工具调用总次数（Harness「机械强制」第一道闸）
TOOL_CALL_BUDGET=12
# 单个工具结果的最大字符数（超出即截断，防上下文爆炸）
TOOL_RESULT_MAX_CHARS=16000

# 网页抓取走 Jina Reader（免费，无需 key；填 key 可提额度）
JINA_READER_BASE_URL=https://r.jina.ai/
JINA_SEARCH_BASE_URL=https://s.jina.ai/
JINA_API_KEY=

# ------------------------------------------------------------ 调度
SCHEDULER_ENABLED=false
WEEKLY_REPORT_CRON=0 9 * * 1

# ------------------------------------------------------------ 流水线（第 5 篇）
# ⚠️ HITL 的暂停状态存在 Agno 的 db 里，开发态也必须配，
#    否则流程挂起后无法恢复。路径相对 apps/backend。
WORKFLOW_DB=agno_workflow.db
# 候选少于这个数就不写一期（走 Condition 的 else 分支显式收尾）
MIN_CANDIDATES=3

# ------------------------------------------------------------ Agent 层（第 2 篇）
# 提示词模板目录（相对 backend 根目录）
PROMPTS_DIR=src/zhixun/prompts
# 生产环境建议 false：强制所有 Agent 从模板加载，禁止内联提示词
ALLOW_INLINE_PROMPTS=false

# ------------------------------------------------------------ Harness（驾驭层）
ENABLE_HARNESS=true
CONTEXT_UNLOAD_THRESHOLD=0.85
CONTEXT_MAX_TOKENS=128000
# Agno 3.x 原生：超长工具结果自动卸载，避免上下文爆炸
OFFLOAD_TOOL_RESULTS=true
TOOL_OFFLOAD_THRESHOLD_CHARS=16000
# Agno 3.x 原生护栏（PromptInjection / PII / Moderation），第 7 篇启用
ENABLE_NATIVE_GUARDRAILS=false
