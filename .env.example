# ============================================================
# 智讯助手 · 环境变量样例
# 复制为 .env 后填写真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，千万不要提交
# ============================================================

# ------------------------------------------------------------ 运行环境
APP_NAME=智讯助手
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------ LLM（至少填一个）
# 用哪家就填哪家，并在 LLM_PROVIDER 里指定
# 模型 id 以 Agno 3.x 的默认为基准，升级框架时只改这里
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5.4
OPENAI_LIGHT_MODEL=gpt-5.4-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_LIGHT_MODEL=deepseek-v4-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

LLM_TEMPERATURE=0.3

# ------------------------------------------------------------ 数据库
# 开发态用 SQLite（默认即可），生产态切 Postgres：
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/zhixun
DATABASE_URL=

# ------------------------------------------------------------ 向量库
VECTOR_DB_URI=
VECTOR_TABLE_ARTICLES=historical_articles

# ------------------------------------------------------------ 知识层
DEDUP_SIMILARITY_THRESHOLD=0.85
RAG_TOP_K=5

# ------------------------------------------------------------ 采集
# GitHub Token 可选，但填了能显著提高 API 限额（5000/h vs 60/h）
GITHUB_TOKEN=
COLLECTOR_MAX_ITEMS=30

# ------------------------------------------------------------ 调度
SCHEDULER_ENABLED=false
WEEKLY_REPORT_CRON=0 9 * * 1

# ------------------------------------------------------------ Agent 层（第 2 篇）
# 提示词模板目录（相对 backend 根目录）
PROMPTS_DIR=src/zhixun/prompts
# 生产环境建议 false：强制所有 Agent 从模板加载，禁止内联提示词
ALLOW_INLINE_PROMPTS=false

# ------------------------------------------------------------ Harness（驾驭层）
ENABLE_HARNESS=true
CONTEXT_UNLOAD_THRESHOLD=0.85
CONTEXT_MAX_TOKENS=128000
# Agno 3.x 原生：超长工具结果自动卸载，避免上下文爆炸
OFFLOAD_TOOL_RESULTS=true
TOOL_OFFLOAD_THRESHOLD_CHARS=16000
# Agno 3.x 原生护栏（PromptInjection / PII / Moderation），第 7 篇启用
ENABLE_NATIVE_GUARDRAILS=false
