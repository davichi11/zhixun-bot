# 前端镜像：多阶段构建（Node 构建 → Nginx 托管静态产物）
# 构建：docker build -f infra/docker/Dockerfile.frontend -t zhixun-frontend .

# ---- 构建阶段 ----
FROM node:20-alpine AS builder

RUN corepack enable

WORKDIR /app

COPY pnpm-workspace.yaml package.json ./
COPY apps/frontend/package.json ./apps/frontend/
RUN pnpm install --filter @zhixun/frontend... --frozen-lockfile || pnpm install --filter @zhixun/frontend...

COPY apps/frontend ./apps/frontend
RUN pnpm --filter @zhixun/frontend build

# ---- 运行阶段 ----
FROM nginx:1.27-alpine

COPY --from=builder /app/apps/frontend/dist /usr/share/nginx/html
COPY infra/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
