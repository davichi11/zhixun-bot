# 后端镜像
# 构建：docker build -f infra/docker/Dockerfile.backend -t zhixun-backend .

FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy

# uv 二进制
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# ---- 依赖层（先装依赖，利用缓存）----
COPY apps/backend/pyproject.toml apps/backend/README.md ./apps/backend/
RUN cd apps/backend && uv sync --no-install-project --no-dev

# ---- 源码层 ----
COPY apps/backend ./apps/backend
RUN cd apps/backend && uv sync --no-dev

WORKDIR /app/apps/backend

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/health')"

# 生产态：不用 --reload，worker 数按 CPU 调整
CMD ["uv", "run", "uvicorn", "zhixun.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
